/*
 * Container images per process. Pinned to the same versions as upstream's
 * config/conda_env.yaml so outputs stay byte-comparable when ucladx/bcl-qc
 * is re-run for parity checks.
 *
 * Dragen runs on the host (it is not distributed as a container), so
 * BCL_CONVERT and DRAGEN_ALIGN have no container directive.
 */

process {

    withName: SAVE_OCC_PF_PLOT {
        // interop 1.3.2 + pandas 2.2.2 + seaborn 0.13.2 + matplotlib 3.9.1
        container = 'quay.io/biocontainers/mulled-v2-interop-pandas-seaborn:1.3.2--py312_0'
    }

    withName: PICARD_QCSUM {
        // picard 3.3.0 plus perl 5.x for qcsum_metrics.pl
        container = 'quay.io/biocontainers/mulled-v2-picard-perl:3.3.0--hdfd78af_0'
    }

    withName: AGGREGATE_QCSUM {
        container = 'python:3.12-slim'
    }

    withName: MULTIQC {
        container = 'quay.io/biocontainers/multiqc:1.23--pyhdfd78af_0'
    }
}
