/*
 * Panel references and Dragen binary locations.
 * Override any of these on the command line (e.g. --dragen_version 4.4)
 * or via -params-file site.yaml.
 */

params {

    // ---- Dragen binary resolution -----------------------------------------
    // Operator selects which installed Dragen to use; every host process
    // resolves to dragen_versions[dragen_version]. This avoids assuming
    // `dragen` is on $PATH and lets multiple Dragen builds coexist.
    dragen_version = '4.3'
    dragen_versions = [
        '4.2': '/opt/edico/bin/dragen',
        '4.3': '/opt/dragen-4.3/bin/dragen',
        '4.4': '/opt/dragen-4.4/bin/dragen',
    ]

    // ---- Panel-specific references ---------------------------------------
    // Matches bclqc.py PANEL_CONFIG. Keep keys in sync with index-flavor
    // detection in main.nf (I10 -> PCP, U5N2_I10 -> HEME, I8N2_N10 skipped).
    panels = [
        PCP : [
            bed: '/mnt/pns/tracks/ucla_mdl_cancer_ngs_v1_exon_targets.hg38.bed',
            ref: '/staging/human/reference/hg38_alt_masked_graph_v3',
        ],
        HEME: [
            bed: '/mnt/pns/tracks/goal_ucla_heme_221_exon_targets.hg38.bed',
            ref: '/staging/human/reference/hg38_alt_masked_graph_v3',
        ],
    ]

    // Picard CollectHsMetrics reference FASTA
    picard_ref = '/mnt/pns/tracks/ref/hg38.fa'

    // Dragen intermediate scratch
    intermediate_results_dir = '/staging/tmp'
}
