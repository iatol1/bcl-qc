/*
 * bcl-qc Nextflow pipeline configuration.
 * Profiles: conda (default for sites without containers), docker, singularity, test.
 */

manifest {
    name            = 'ucladx/bcl-qc'
    author          = 'UCLA MDL'
    description     = 'Demux, align, and QC Illumina clinical NGS runs via Dragen + Picard + MultiQC'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.10.0'
    version         = '2.0.0'
}

// Panel references and Dragen version map
includeConfig 'conf/panels.config'

// Process-level container images
includeConfig 'conf/containers.config'

process {
    // Conservative defaults; override per-process below if needed
    cpus     = 2
    memory   = '8 GB'
    time     = '4h'
    cache    = 'lenient'
    errorStrategy = { task.exitStatus in [137,143,104] ? 'retry' : 'terminate' }
    maxRetries    = 1

    withName: BCL_CONVERT  { cpus = 32; memory = '64 GB'; time = '12h' }
    withName: DRAGEN_ALIGN { cpus = 32; memory = '64 GB'; time = '12h' }
    withName: MULTIQC      { cpus = 2;  memory = '8 GB';  time = '1h' }
}

profiles {
    conda {
        conda.enabled = true
        process.conda = "${projectDir}/config/conda_env.yaml"
    }
    docker {
        docker.enabled        = true
        docker.runOptions     = '-u $(id -u):$(id -g)'
        singularity.enabled   = false
    }
    singularity {
        singularity.enabled   = true
        singularity.autoMounts = true
        docker.enabled        = false
    }
    test {
        // Resolve to a no-op path so dragenBin() never falsely claims Dragen exists;
        // the test profile pairs with `-stub` which skips the real script blocks.
        params.dragen_versions = ['stub': '/bin/true']
        params.dragen_version  = 'stub'
        params.run_dir         = "${projectDir}/demo_run"
        params.sampleinfo      = "${projectDir}/tests/fixtures/sampleinfo.tsv"
        params.fastqs_dir      = "${launchDir}/results/reads"
        params.bams_dir        = "${launchDir}/results/bams"
        // No containers; stubs only emit empty files
        docker.enabled       = false
        singularity.enabled  = false
        conda.enabled        = false
    }
}

// Provenance artifacts — useful for clinical-lab audit trails.
report {
    enabled   = true
    file      = "${params.bams_dir}/pipeline_info/report.html"
    overwrite = true
}
timeline {
    enabled   = true
    file      = "${params.bams_dir}/pipeline_info/timeline.html"
    overwrite = true
}
trace {
    enabled   = true
    file      = "${params.bams_dir}/pipeline_info/trace.txt"
    overwrite = true
}
dag {
    enabled   = true
    file      = "${params.bams_dir}/pipeline_info/dag.svg"
    overwrite = true
}
